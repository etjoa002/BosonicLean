import BosonicLean.Fock.Ladder

/-!
# Number states of a single mode

The number state `∣j⟩` of a single mode is the vector of the formal Fock space with the single
nonzero coefficient `1` at occupation `j`. The ladder operators act on it by
`a†∣j⟩ = √(j+1) ∣j+1⟩` and `a∣k+1⟩ = √(k+1) ∣k⟩`, `a∣0⟩ = 0`; the matrix element `⟨i∣O∣j⟩` of a
linear operator is the coefficient of `O∣j⟩` at `∣i⟩`.

## Main definitions

* `BosonicLean.Fock.FormalFock.numberState j`: the number state `∣j⟩`.
* `BosonicLean.Fock.FormalFock.matrixElement O i j`: `⟨i∣O∣j⟩`.

## Main results

* `create_pow_numberState`, `annihilate_pow_numberState`: `(a†)ⁿ∣j⟩` and `aᵐ∣k⟩`.
* `matrixElement_annihilate_pow_mul_create_pow`: `⟨i∣aᵐ(a†)ⁿ∣j⟩`.
* `matrixElement_create_mul_annihilate`: `⟨i∣a†a∣j⟩ = ⟨i∣aa†∣j⟩ - δᵢⱼ`.
* `matrixElement_add`, `matrixElement_sub`, `matrixElement_smul`, `matrixElement_sum`: `⟨i∣O∣j⟩` is
  linear in `O`.
* `annihilate_mul_create`, `annihilate_pow_succ_mul_create`: `aa† = a†a + 1` and
  `aᵐ⁺¹a† = a†aᵐ⁺¹ + (m+1)aᵐ`.
* `toSubmodule_adjoin_annihilate_create`: the anti-normal-ordered monomials `aᵐ(a†)ⁿ` span the
  algebra generated by `a` and `a†` (GA-BMPS milestone B6, (1a)).
* `number_sq`: `n² = a²(a†)² - 3aa† + 1` (Tjoa–Cirac, Example 1; B6, (1b)).
-/

namespace BosonicLean.Fock

/-- `√(ab) = √a √b` for natural numbers, in `ℂ`. -/
theorem sqrtC_mul (a b : ℕ) : sqrtC (a * b) = sqrtC a * sqrtC b := by
  simp only [sqrtC, Nat.cast_mul, Real.sqrt_mul (Nat.cast_nonneg a), Complex.ofReal_mul]

namespace FormalFock

/-- The number state `∣j⟩` of a single mode. -/
noncomputable def numberState (j : ℕ) : FormalFock Unit ℂ := single (Finsupp.single () j) 1

/-- The matrix element `⟨i∣O∣j⟩` of a `ℂ`-linear operator `O` on the single-mode formal Fock
space: the coefficient of `O∣j⟩` at `∣i⟩`. -/
noncomputable def matrixElement (O : Module.End ℂ (FormalFock Unit ℂ)) (i j : ℕ) : ℂ :=
  (O (numberState j)).coeff (Finsupp.single () i)

/-- The coefficients of `∣j⟩`: `1` at occupation `j` and `0` elsewhere. -/
theorem coeff_numberState (j : ℕ) (n : Unit →₀ ℕ) :
    (numberState j).coeff n = if n () = j then 1 else 0 := by
  rw [numberState, coeff_single]
  congr 1
  apply propext
  constructor
  · rintro rfl
    simp
  · intro h
    rw [Finsupp.unique_single n, ← h]

/-- `a† ∣j⟩ = √(j+1) ∣j+1⟩`. -/
theorem create_numberState (j : ℕ) :
    create () (numberState j) = sqrtC (j + 1) • numberState (j + 1) := by
  ext n
  rw [coeff_create, coeff_smul, coeff_numberState, coeff_numberState]
  simp only [Finsupp.coe_tsub, Pi.sub_apply, Finsupp.single_eq_same, smul_eq_mul]
  generalize n () = k
  rcases k with _ | k
  · simp
  · by_cases h : k = j
    · subst h
      simp
    · simp [h]

/-- `a ∣k+1⟩ = √(k+1) ∣k⟩`. -/
theorem annihilate_numberState_succ (k : ℕ) :
    annihilate () (numberState (k + 1)) = sqrtC (k + 1) • numberState k := by
  ext n
  rw [coeff_annihilate, coeff_smul, coeff_numberState, coeff_numberState]
  simp only [Finsupp.coe_add, Pi.add_apply, Finsupp.single_eq_same, smul_eq_mul]
  generalize n () = l
  by_cases h : l = k
  · subst h
    simp
  · simp [h]

/-- `a ∣0⟩ = 0`: the annihilation operator kills the vacuum. -/
theorem annihilate_numberState_zero : annihilate () (numberState 0) = 0 := by
  ext n
  rw [coeff_annihilate, coeff_numberState, coeff_zero]
  simp

/-- `(a†)ⁿ ∣j⟩ = (√(j+n)! / √j!) ∣j+n⟩`. -/
theorem create_pow_numberState (n j : ℕ) :
    (create () ^ n) (numberState j) =
      (sqrtC (j + n).factorial / sqrtC j.factorial) • numberState (j + n) := by
  induction n with
  | zero =>
    have : sqrtC j.factorial ≠ 0 := sqrtC_ne_zero (Nat.factorial_pos j)
    simp [this]
  | succ n ih =>
    rw [pow_succ', Module.End.mul_apply, ih, map_smul, create_numberState, smul_smul,
      ← add_assoc, Nat.factorial_succ (j + n), sqrtC_mul]
    congr 1
    ring

/-- `aᵐ ∣k⟩ = (√k! / √(k-m)!) ∣k-m⟩` if `m ≤ k`, and `0` otherwise. -/
theorem annihilate_pow_numberState (m k : ℕ) :
    (annihilate () ^ m) (numberState k) =
      if m ≤ k then (sqrtC k.factorial / sqrtC (k - m).factorial) • numberState (k - m) else 0 := by
  induction m with
  | zero =>
    have : sqrtC k.factorial ≠ 0 := sqrtC_ne_zero (Nat.factorial_pos k)
    simp [this]
  | succ m ih =>
    rw [pow_succ', Module.End.mul_apply, ih]
    by_cases hm : m + 1 ≤ k
    · have hm' : m ≤ k := by omega
      obtain ⟨d, hd⟩ : ∃ d, k - m = d + 1 := ⟨k - m - 1, by omega⟩
      have hd' : k - (m + 1) = d := by omega
      simp only [hm', hm, ↓reduceIte, map_smul, hd, hd', annihilate_numberState_succ, smul_smul]
      congr 1
      rw [Nat.factorial_succ d, sqrtC_mul]
      have h1 : sqrtC (d + 1) ≠ 0 := sqrtC_ne_zero (by omega)
      have h2 : sqrtC d.factorial ≠ 0 := sqrtC_ne_zero (Nat.factorial_pos _)
      field_simp
    · simp only [hm, ↓reduceIte]
      by_cases h : m ≤ k
      · have hkm : k - m = 0 := by omega
        simp only [h, ↓reduceIte, hkm, map_smul, annihilate_numberState_zero, smul_zero]
      · simp only [h, ↓reduceIte, map_zero]

/-- **Matrix elements of anti-normal-ordered monomials.**
`⟨i∣aᵐ(a†)ⁿ∣j⟩ = (j+n)! / √(i! j!)` if `i + m = j + n`, and `0` otherwise. -/
theorem matrixElement_annihilate_pow_mul_create_pow (m n i j : ℕ) :
    matrixElement (annihilate () ^ m * create () ^ n) i j =
      if i + m = j + n then ((j + n).factorial : ℂ) / (sqrtC i.factorial * sqrtC j.factorial)
      else 0 := by
  rw [matrixElement, Module.End.mul_apply, create_pow_numberState, map_smul,
    annihilate_pow_numberState]
  by_cases h : i + m = j + n
  · have hm : m ≤ j + n := by omega
    have hi : j + n - m = i := by omega
    simp only [hm, h, ↓reduceIte, coeff_smul, coeff_numberState, Finsupp.single_eq_same, hi,
      smul_eq_mul, mul_one]
    rw [div_mul_div_comm, sqrtC_mul_self, mul_comm (sqrtC j.factorial)]
  · simp only [h, ↓reduceIte]
    split_ifs with hm
    · have hi : ¬ i = j + n - m := by omega
      simp [coeff_numberState, hi]
    · simp

/-- `⟨i∣a†a∣j⟩ = ⟨i∣aa†∣j⟩ - δᵢⱼ`, from the canonical commutation relation `[a, a†] = 1`. -/
theorem matrixElement_create_mul_annihilate (i j : ℕ) :
    matrixElement (create () * annihilate ()) i j =
      matrixElement (annihilate () * create ()) i j - if i = j then 1 else 0 := by
  have hccr : (create () * annihilate () : Module.End ℂ (FormalFock Unit ℂ)) =
      annihilate () * create () - 1 := by
    have h := lie_annihilate_create (R := ℂ) () ()
    simp only [↓reduceIte, Ring.lie_def] at h
    rw [← h]
    abel
  rw [hccr, matrixElement, matrixElement, LinearMap.sub_apply, coeff_sub, Module.End.one_apply,
    coeff_numberState]
  simp only [Finsupp.single_eq_same]

/-- `⟨i∣O + O'∣j⟩ = ⟨i∣O∣j⟩ + ⟨i∣O'∣j⟩`. -/
theorem matrixElement_add (O O' : Module.End ℂ (FormalFock Unit ℂ)) (i j : ℕ) :
    matrixElement (O + O') i j = matrixElement O i j + matrixElement O' i j :=
  rfl

/-- `⟨i∣O - O'∣j⟩ = ⟨i∣O∣j⟩ - ⟨i∣O'∣j⟩`. -/
theorem matrixElement_sub (O O' : Module.End ℂ (FormalFock Unit ℂ)) (i j : ℕ) :
    matrixElement (O - O') i j = matrixElement O i j - matrixElement O' i j :=
  rfl

/-- `⟨i∣c O∣j⟩ = c ⟨i∣O∣j⟩`. -/
theorem matrixElement_smul (c : ℂ) (O : Module.End ℂ (FormalFock Unit ℂ)) (i j : ℕ) :
    matrixElement (c • O) i j = c * matrixElement O i j :=
  rfl

/-- `⟨i∣Σₖ Oₖ∣j⟩ = Σₖ ⟨i∣Oₖ∣j⟩`. -/
theorem matrixElement_sum {α : Type*} (s : Finset α) (O : α → Module.End ℂ (FormalFock Unit ℂ))
    (i j : ℕ) : matrixElement (∑ k ∈ s, O k) i j = ∑ k ∈ s, matrixElement (O k) i j := by
  simp only [matrixElement, LinearMap.sum_apply, coeff_sum]

/-! ### Anti-normal ordering -/

/-- The canonical commutation relation in the form `a a† = a† a + 1`. -/
theorem annihilate_mul_create :
    (annihilate () * create () : Module.End ℂ (FormalFock Unit ℂ)) =
      create () * annihilate () + 1 := by
  have h := lie_annihilate_create (R := ℂ) () ()
  simp only [↓reduceIte, Ring.lie_def] at h
  rw [← h]
  abel

/-- `aᵐ⁺¹ a† = a† aᵐ⁺¹ + (m + 1) aᵐ`. -/
theorem annihilate_pow_succ_mul_create (m : ℕ) :
    (annihilate () ^ (m + 1) * create () : Module.End ℂ (FormalFock Unit ℂ)) =
      create () * annihilate () ^ (m + 1) + (m + 1) • annihilate () ^ m := by
  induction m with
  | zero => simp [annihilate_mul_create]
  | succ m ih =>
    rw [pow_succ', mul_assoc, ih, mul_add, ← mul_assoc, annihilate_mul_create, mul_smul_comm,
      ← pow_succ', add_mul, one_mul, mul_assoc, ← pow_succ', add_assoc, ← succ_nsmul']

/-- The anti-normal-ordered monomial `aᵐ (a†)ⁿ` lies in the algebra generated by `a` and `a†`. -/
theorem annihilate_pow_mul_create_pow_mem_adjoin (m n : ℕ) :
    (annihilate () : Module.End ℂ (FormalFock Unit ℂ)) ^ m * create () ^ n ∈
      Algebra.adjoin ℂ {(annihilate () : Module.End ℂ (FormalFock Unit ℂ)), create ()} :=
  Subalgebra.mul_mem _ (Subalgebra.pow_mem _ (Algebra.subset_adjoin (by simp)) _)
    (Subalgebra.pow_mem _ (Algebra.subset_adjoin (by simp)) _)

/-- **Anti-normal ordering.** The anti-normal-ordered monomials `aᵐ (a†)ⁿ`, `m, n ∈ ℕ`, span the
algebra generated by `a` and `a†`: by `aᵐ⁺¹ a† = a† aᵐ⁺¹ + (m + 1) aᵐ`, left multiplication by `a`
and by `a†` preserves their span, which contains `1`. -/
theorem toSubmodule_adjoin_annihilate_create :
    Subalgebra.toSubmodule (Algebra.adjoin ℂ
      {(annihilate () : Module.End ℂ (FormalFock Unit ℂ)), create ()}) =
      Submodule.span ℂ (Set.range fun p : ℕ × ℕ =>
        (annihilate () : Module.End ℂ (FormalFock Unit ℂ)) ^ p.1 * create () ^ p.2) := by
  set a : Module.End ℂ (FormalFock Unit ℂ) := annihilate ()
  set c : Module.End ℂ (FormalFock Unit ℂ) := create ()
  set M := Submodule.span ℂ (Set.range fun p : ℕ × ℕ => a ^ p.1 * c ^ p.2)
  have hmono : ∀ m n, a ^ m * c ^ n ∈ M := fun m n => Submodule.subset_span ⟨(m, n), rfl⟩
  have ha : ∀ x ∈ M, a * x ∈ M := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨⟨m, n⟩, rfl⟩ := hx
      simpa only [← mul_assoc, ← pow_succ'] using hmono (m + 1) n
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add]; exact M.add_mem hx hy
    | smul r x _ hx => rw [mul_smul_comm]; exact M.smul_mem r hx
  have hc : ∀ x ∈ M, c * x ∈ M := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨⟨m, n⟩, rfl⟩ := hx
      rcases m with _ | m
      · simpa only [pow_zero, one_mul, ← pow_succ'] using hmono 0 (n + 1)
      · have e : c * (a ^ (m + 1) * c ^ n) =
            a ^ (m + 1) * c ^ (n + 1) - (m + 1) • (a ^ m * c ^ n) := by
          rw [pow_succ' c n, ← mul_assoc, ← mul_assoc, annihilate_pow_succ_mul_create m, add_mul,
            smul_mul_assoc, mul_assoc]
          abel
        rw [e]
        exact M.sub_mem (hmono _ _) (M.smul_of_tower_mem _ (hmono _ _))
    | zero => simp
    | add x y _ _ hx hy => rw [mul_add]; exact M.add_mem hx hy
    | smul r x _ hx => rw [mul_smul_comm]; exact M.smul_mem r hx
  have hall : ∀ y ∈ Algebra.adjoin ℂ {a, c}, ∀ x ∈ M, y * x ∈ M := by
    intro y hy
    induction hy using Algebra.adjoin_induction with
    | mem y hy =>
      rcases hy with rfl | rfl
      · exact ha
      · exact hc
    | algebraMap r =>
      intro x hx
      rw [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
      exact M.smul_mem r hx
    | add y z _ _ hy hz =>
      intro x hx
      rw [add_mul]
      exact M.add_mem (hy x hx) (hz x hx)
    | mul y z _ _ hy hz =>
      intro x hx
      rw [mul_assoc]
      exact hy _ (hz x hx)
  refine le_antisymm (fun y hy => ?_) (Submodule.span_le.2 ?_)
  · simpa using hall y hy 1 (by simpa using hmono 0 0)
  · rintro _ ⟨⟨m, n⟩, rfl⟩
    exact annihilate_pow_mul_create_pow_mem_adjoin m n

/-- **The square of the number operator** (Tjoa–Cirac, Example 1):
`n² = a² (a†)² - 3 a a† + 1` with `n = a† a`. -/
theorem number_sq :
    ((create () : Module.End ℂ (FormalFock Unit ℂ)) * annihilate ()) ^ 2 =
      annihilate () ^ 2 * create () ^ 2 - 3 • (annihilate () * create ()) + 1 := by
  set a : Module.End ℂ (FormalFock Unit ℂ) := annihilate ()
  set c : Module.End ℂ (FormalFock Unit ℂ) := create ()
  have h : c * a = a * c - 1 := by rw [annihilate_mul_create]; abel
  have hx : (a * c) * (a * c) = a ^ 2 * c ^ 2 - a * c := by
    rw [mul_assoc, ← mul_assoc c, h, sub_mul, one_mul, mul_sub, sq, sq, mul_assoc, mul_assoc]
  rw [sq, h, sub_mul, mul_sub, mul_sub, one_mul, mul_one, mul_one, hx]
  abel

end FormalFock

end BosonicLean.Fock
