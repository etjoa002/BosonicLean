import Mathlib.Analysis.CStarAlgebra.Hom
import Mathlib.Topology.Algebra.StarSubalgebra

/-!
# Commuting C*-subalgebras

Closed star subalgebras generated by mutually commuting sets, and by their adjoints, commute.

## Main statements

* `BosonicLean.commute_of_mem_topologicalClosure_adjoin`
-/

namespace BosonicLean

open StarAlgebra StarSubalgebra

variable {A : Type*} [CStarAlgebra A]

/-- The C*-subalgebra generated by `s` lies in the commutant of `t ∪ t*` when every element of
`s` commutes with every element of `t` and with its adjoint. -/
theorem topologicalClosure_adjoin_le_centralizer {s t : Set A}
    (h : ∀ a ∈ s, ∀ b ∈ t, Commute a b) (h' : ∀ a ∈ s, ∀ b ∈ t, Commute a (star b)) :
    (adjoin ℂ s).topologicalClosure ≤ centralizer ℂ t := by
  apply topologicalClosure_minimal
  · rw [adjoin_le_iff]
    intro a ha
    rw [SetLike.mem_coe, mem_centralizer_iff]
    exact fun g hg => ⟨(h a ha g hg).eq.symm, (h' a ha g hg).eq.symm⟩
  · rw [coe_centralizer]
    exact Set.isClosed_centralizer _

/-- If every element of `s` commutes with every element of `t` and with its adjoint, then every
element of the C*-subalgebra generated by `s` commutes with every element of the C*-subalgebra
generated by `t`. -/
theorem commute_of_mem_topologicalClosure_adjoin {s t : Set A}
    (h : ∀ a ∈ s, ∀ b ∈ t, Commute a b) (h' : ∀ a ∈ s, ∀ b ∈ t, Commute a (star b))
    {x y : A} (hx : x ∈ (adjoin ℂ s).topologicalClosure)
    (hy : y ∈ (adjoin ℂ t).topologicalClosure) : Commute x y := by
  have hC := topologicalClosure_adjoin_le_centralizer h h'
  have hxC := hC hx
  have hsxC := hC (star_mem hx)
  rw [mem_centralizer_iff] at hxC hsxC
  have hyC := topologicalClosure_adjoin_le_centralizer (s := t) (t := {x})
    (fun b hb x' hx' => by rw [Set.mem_singleton_iff.1 hx']; exact (hxC b hb).1)
    (fun b hb x' hx' => by rw [Set.mem_singleton_iff.1 hx']; exact (hsxC b hb).1) hy
  rw [mem_centralizer_iff] at hyC
  exact ((hyC x rfl).1)

end BosonicLean
