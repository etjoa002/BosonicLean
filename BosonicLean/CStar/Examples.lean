import BosonicLean.CStar.Commute
import Mathlib.Analysis.CStarAlgebra.CStarMatrix
import Mathlib.LinearAlgebra.Matrix.Kronecker

/-!
# Examples for the commutation lemma

Two examples, in the namespace `BosonicLean.CStarExample`, in matrix C*-algebras (`CStarMatrix`,
the operator-norm C*-algebra of complex matrices) that accompany
`commute_of_mem_topologicalClosure_adjoin`.

* Two qubits: in `M₂(ℂ) ⊗ M₂(ℂ)`, realized as matrices indexed by `Fin 2 × Fin 2` with Kronecker
  products, the C*-subalgebras generated by elements `a ⊗ 1` and by elements `1 ⊗ b` commute
  elementwise.
* An element commuting with itself: the nilpotent `e = !![0, 1; 0, 0]` commutes with itself but
  not with `star e`, so the lemma fails without its hypothesis on adjoints.

## Main statements

* `commute_of_mem_topologicalClosure_adjoin_kronecker`
* `coe_topologicalClosure_adjoin_kronLeft_pauli`, `coe_topologicalClosure_adjoin_kronRight_pauli`
* `adjoin_nilpotent_eq_top`, `not_commute_nilpotent_star`, `not_forall_commute_of_commute`
-/

namespace BosonicLean.CStarExample

open StarAlgebra Matrix
open scoped ComplexOrder Kronecker

/-- The element `a ⊗ 1` of the two-qubit algebra. -/
noncomputable def kronLeft (a : Matrix (Fin 2) (Fin 2) ℂ) :
    CStarMatrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ :=
  CStarMatrix.ofMatrix (a ⊗ₖ (1 : Matrix (Fin 2) (Fin 2) ℂ))

/-- The element `1 ⊗ b` of the two-qubit algebra. -/
noncomputable def kronRight (b : Matrix (Fin 2) (Fin 2) ℂ) :
    CStarMatrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ :=
  CStarMatrix.ofMatrix ((1 : Matrix (Fin 2) (Fin 2) ℂ) ⊗ₖ b)

theorem commute_kronLeft_kronRight (a b : Matrix (Fin 2) (Fin 2) ℂ) :
    Commute (kronLeft a) (kronRight b) := by
  change a ⊗ₖ 1 * (1 ⊗ₖ b) = 1 ⊗ₖ b * (a ⊗ₖ 1)
  rw [← mul_kronecker_mul, ← mul_kronecker_mul]
  simp

theorem star_kronRight (b : Matrix (Fin 2) (Fin 2) ℂ) :
    star (kronRight b) = kronRight (star b) := by
  change ((1 : Matrix (Fin 2) (Fin 2) ℂ) ⊗ₖ b)ᴴ = 1 ⊗ₖ bᴴ
  rw [conjTranspose_kronecker, conjTranspose_one]

/-- Two qubits: for any sets `S` and `T` of `2 × 2` matrices, every element of the C*-algebra
generated by `{a ⊗ 1 | a ∈ S}` commutes with every element of the C*-algebra generated by
`{1 ⊗ b | b ∈ T}`. -/
theorem commute_of_mem_topologicalClosure_adjoin_kronecker
    (S T : Set (Matrix (Fin 2) (Fin 2) ℂ))
    {x y : CStarMatrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ}
    (hx : x ∈ (adjoin ℂ (kronLeft '' S)).topologicalClosure)
    (hy : y ∈ (adjoin ℂ (kronRight '' T)).topologicalClosure) : Commute x y := by
  refine BosonicLean.commute_of_mem_topologicalClosure_adjoin ?_ ?_ hx hy
  · rintro _ ⟨a, -, rfl⟩ _ ⟨b, -, rfl⟩
    exact commute_kronLeft_kronRight a b
  · rintro _ ⟨a, -, rfl⟩ _ ⟨b, -, rfl⟩
    rw [star_kronRight]
    exact commute_kronLeft_kronRight a (star b)

/-! ### The generated algebras are `M₂ ⊗ 1` and `1 ⊗ M₂` -/

/-- The Pauli matrix `σ_x`. -/
def pauliX : Matrix (Fin 2) (Fin 2) ℂ := !![0, 1; 1, 0]

/-- The Pauli matrix `σ_z`. -/
def pauliZ : Matrix (Fin 2) (Fin 2) ℂ := !![1, 0; 0, -1]

/-- `σ_x` and `σ_z` generate `M₂(ℂ)` as a star algebra. -/
theorem adjoin_pauli_eq_top :
    adjoin ℂ ({pauliX, pauliZ} : Set (Matrix (Fin 2) (Fin 2) ℂ)) = ⊤ := by
  refine eq_top_iff.2 fun m _ => ?_
  have hX : pauliX ∈ adjoin ℂ ({pauliX, pauliZ} : Set (Matrix (Fin 2) (Fin 2) ℂ)) :=
    subset_adjoin ℂ _ (by simp)
  have hZ : pauliZ ∈ adjoin ℂ ({pauliX, pauliZ} : Set (Matrix (Fin 2) (Fin 2) ℂ)) :=
    subset_adjoin ℂ _ (by simp)
  have key : m = (m 0 0 / 2) • (1 + pauliZ) + (m 1 1 / 2) • (1 - pauliZ) +
      (m 0 1 / 2) • (pauliX - pauliX * pauliZ) + (m 1 0 / 2) • (pauliX + pauliX * pauliZ) := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [pauliX, pauliZ] <;> ring
  rw [key]
  have h1 := one_mem (adjoin ℂ ({pauliX, pauliZ} : Set (Matrix (Fin 2) (Fin 2) ℂ)))
  have hXZ := mul_mem hX hZ
  open SMulMemClass in
  exact add_mem (add_mem (add_mem (smul_mem _ (add_mem h1 hZ)) (smul_mem _ (sub_mem h1 hZ)))
    (smul_mem _ (sub_mem hX hXZ))) (smul_mem _ (add_mem hX hXZ))

/-- If a star-algebra homomorphism from `M₂(ℂ)` into a C*-algebra is given, the C*-algebra
generated by the images of `σ_x` and `σ_z` is its range. -/
theorem coe_topologicalClosure_adjoin_image_pauli {B : Type*} [CStarAlgebra B]
    (φ : Matrix (Fin 2) (Fin 2) ℂ →⋆ₐ[ℂ] B) :
    ((adjoin ℂ (φ '' {pauliX, pauliZ})).topologicalClosure : Set B) = Set.range φ := by
  have hmap : adjoin ℂ (φ '' {pauliX, pauliZ}) = φ.range := by
    rw [← StarAlgHom.map_adjoin, adjoin_pauli_eq_top, StarAlgHom.range_eq_map_top]
  have hclosed : IsClosed (Set.range φ) := by
    have := (LinearMap.range (φ.toAlgHom.toLinearMap)).closed_of_finiteDimensional
    simpa [LinearMap.coe_range] using this
  rw [hmap]
  apply Set.Subset.antisymm
  · have : φ.range.topologicalClosure ≤ φ.range :=
      StarSubalgebra.topologicalClosure_minimal le_rfl hclosed
    intro x hx
    exact this hx
  · intro x hx
    exact StarSubalgebra.le_topologicalClosure _ hx

/-- `a ↦ a ⊗ 1` as a star-algebra homomorphism. -/
noncomputable def kronLeftHom :
    Matrix (Fin 2) (Fin 2) ℂ →⋆ₐ[ℂ] CStarMatrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ where
  toFun := kronLeft
  map_one' := by
    change (1 : Matrix (Fin 2) (Fin 2) ℂ) ⊗ₖ (1 : Matrix (Fin 2) (Fin 2) ℂ) =
      (1 : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ)
    exact one_kronecker_one
  map_mul' a b := by
    change (a * b) ⊗ₖ 1 = a ⊗ₖ 1 * (b ⊗ₖ (1 : Matrix (Fin 2) (Fin 2) ℂ))
    rw [← mul_kronecker_mul, mul_one]
  map_zero' := by simp [kronLeft]
  map_add' a b := by simp [kronLeft, add_kronecker]
  commutes' c := by
    rw [Algebra.algebraMap_eq_smul_one (A := CStarMatrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ),
      Algebra.algebraMap_eq_smul_one]
    change (c • (1 : Matrix (Fin 2) (Fin 2) ℂ)) ⊗ₖ (1 : Matrix (Fin 2) (Fin 2) ℂ) =
      c • (1 : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ)
    rw [smul_kronecker, one_kronecker_one]
  map_star' a := by
    change (star a ⊗ₖ (1 : Matrix (Fin 2) (Fin 2) ℂ)) = (a ⊗ₖ 1)ᴴ
    rw [conjTranspose_kronecker, conjTranspose_one]; rfl

/-- `b ↦ 1 ⊗ b` as a star-algebra homomorphism. -/
noncomputable def kronRightHom :
    Matrix (Fin 2) (Fin 2) ℂ →⋆ₐ[ℂ] CStarMatrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ where
  toFun := kronRight
  map_one' := by
    change (1 : Matrix (Fin 2) (Fin 2) ℂ) ⊗ₖ (1 : Matrix (Fin 2) (Fin 2) ℂ) =
      (1 : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ)
    exact one_kronecker_one
  map_mul' a b := by
    change 1 ⊗ₖ (a * b) = (1 : Matrix (Fin 2) (Fin 2) ℂ) ⊗ₖ a * (1 ⊗ₖ b)
    rw [← mul_kronecker_mul, mul_one]
  map_zero' := by simp [kronRight]
  map_add' a b := by simp [kronRight, kronecker_add]
  commutes' c := by
    rw [Algebra.algebraMap_eq_smul_one (A := CStarMatrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ),
      Algebra.algebraMap_eq_smul_one]
    change (1 : Matrix (Fin 2) (Fin 2) ℂ) ⊗ₖ (c • (1 : Matrix (Fin 2) (Fin 2) ℂ)) =
      c • (1 : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ)
    rw [kronecker_smul, one_kronecker_one]
  map_star' b := by
    change ((1 : Matrix (Fin 2) (Fin 2) ℂ) ⊗ₖ star b) = (1 ⊗ₖ b)ᴴ
    rw [conjTranspose_kronecker, conjTranspose_one]; rfl

/-- Two qubits: the C*-algebra generated by `σ_x ⊗ 1` and `σ_z ⊗ 1` is `M₂(ℂ) ⊗ 1`. -/
theorem coe_topologicalClosure_adjoin_kronLeft_pauli :
    ((adjoin ℂ (kronLeft '' {pauliX, pauliZ})).topologicalClosure :
      Set (CStarMatrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ)) = Set.range kronLeft :=
  coe_topologicalClosure_adjoin_image_pauli kronLeftHom

/-- Two qubits: the C*-algebra generated by `1 ⊗ σ_x` and `1 ⊗ σ_z` is `1 ⊗ M₂(ℂ)`. -/
theorem coe_topologicalClosure_adjoin_kronRight_pauli :
    ((adjoin ℂ (kronRight '' {pauliX, pauliZ})).topologicalClosure :
      Set (CStarMatrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ)) = Set.range kronRight :=
  coe_topologicalClosure_adjoin_image_pauli kronRightHom

/-- The nilpotent `e = !![0, 1; 0, 0]` in `M₂(ℂ)`. -/
noncomputable def nilpotent : CStarMatrix (Fin 2) (Fin 2) ℂ :=
  CStarMatrix.ofMatrix !![0, 1; 0, 0]

/-- The nilpotent does not commute with its adjoint. -/
theorem not_commute_nilpotent_star : ¬ Commute nilpotent (star nilpotent) := by
  intro h
  have hM : (!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ℂ) * (!![0, 1; 0, 0] : Matrix _ _ ℂ)ᴴ =
      (!![0, 1; 0, 0] : Matrix (Fin 2) (Fin 2) ℂ)ᴴ * !![0, 1; 0, 0] := h.eq
  have h00 := congrFun (congrFun hM 0) 0
  rw [Matrix.mul_apply, Matrix.mul_apply] at h00
  simp [Fin.sum_univ_two] at h00

/-- The nilpotent and its adjoint generate `M₂(ℂ)` as a star algebra. -/
theorem adjoin_nilpotent_eq_top :
    adjoin ℂ ({nilpotent} : Set (CStarMatrix (Fin 2) (Fin 2) ℂ)) = ⊤ := by
  refine eq_top_iff.2 fun m _ => ?_
  have he : nilpotent ∈ adjoin ℂ ({nilpotent} : Set (CStarMatrix (Fin 2) (Fin 2) ℂ)) :=
    subset_adjoin ℂ _ rfl
  have hs := star_mem he
  have key : m = m 0 0 • (nilpotent * star nilpotent) + m 1 1 • (star nilpotent * nilpotent) +
      m 0 1 • nilpotent + m 1 0 • star nilpotent := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [nilpotent, CStarMatrix.mul_apply, CStarMatrix.star_apply, CStarMatrix.ofMatrix_apply,
        Fin.sum_univ_two]
  rw [key]
  open SMulMemClass in
  exact add_mem (add_mem (add_mem (smul_mem _ (mul_mem he hs)) (smul_mem _ (mul_mem hs he)))
    (smul_mem _ he)) (smul_mem _ hs)

/-- An element commuting with itself: commutation of the generators alone does not make the
generated C*-algebras commute. With `s = t = {e}`, every element of `s` commutes with every
element of `t`, but `e` and `star e` both lie in the generated C*-algebra and do not commute. -/
theorem not_forall_commute_of_commute :
    ¬ ∀ s t : Set (CStarMatrix (Fin 2) (Fin 2) ℂ), (∀ a ∈ s, ∀ b ∈ t, Commute a b) →
      ∀ x ∈ (adjoin ℂ s).topologicalClosure, ∀ y ∈ (adjoin ℂ t).topologicalClosure,
        Commute x y := by
  intro H
  have he : nilpotent ∈ (adjoin ℂ {nilpotent}).topologicalClosure :=
    StarSubalgebra.le_topologicalClosure _ (subset_adjoin ℂ _ rfl)
  refine not_commute_nilpotent_star (H {nilpotent} {nilpotent} ?_ _ he _ (star_mem he))
  rintro a rfl b rfl
  exact Commute.refl _

end BosonicLean.CStarExample
