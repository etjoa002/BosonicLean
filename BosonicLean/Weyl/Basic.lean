import Mathlib.Analysis.InnerProductSpace.l2Space
import Mathlib.Analysis.InnerProductSpace.Adjoint
import Mathlib.Analysis.CStarAlgebra.ContinuousLinearMap
import Mathlib.Analysis.SpecialFunctions.Complex.Circle
import Mathlib.Topology.Algebra.StarSubalgebra
import Mathlib.Algebra.Star.Unitary
import Mathlib.LinearAlgebra.SesquilinearForm.Basic

/-!
# Weyl operators on `ℓ²(V)`

For a real vector space `V` and an alternating bilinear form `σ` on it, the Weyl operator
`W(u)` acts on `ℓ²(V)` (with `V` discrete) by `(W(u)ψ)(v) = e^{iσ(u,v)/2} ψ(v+u)`. The Weyl
operators are unitary, satisfy `W(u) W(w) = e^{-iσ(u,w)/2} W(u+w)`, and generate the
C*-algebra `CCR σ`.

## Main definitions

* `BosonicLean.Weyl.L2 V`: the Hilbert space `ℓ²(V)`.
* `BosonicLean.Weyl.weyl σ u`: the Weyl operator.
* `BosonicLean.Weyl.CCR σ`: the C*-algebra generated by the Weyl operators.

## Main statements

* `BosonicLean.Weyl.norm_weyl_apply`: `W(u)` preserves the norm.
* `weyl_mul`: the Weyl relation.
* `star_weyl`, `weyl_mem_unitary`: `W(u)* = W(-u)`, and `W(u)` is unitary.
-/

open scoped ENNReal ComplexConjugate

noncomputable section

namespace BosonicLean

namespace Weyl

variable {V : Type*} [AddCommGroup V] [Module ℝ V]

/-- The Hilbert space `ℓ²(V)` of square-summable functions on `V`, with `V` discrete. -/
abbrev L2 (V : Type*) := lp (fun _ : V => ℂ) 2

/-- The phase `e^{iσ(u,v)/2}`. -/
def phase (σ : LinearMap.BilinForm ℝ V) (u v : V) : ℂ :=
  Complex.exp (((σ u v / 2 : ℝ) : ℂ) * Complex.I)

theorem norm_phase (σ : LinearMap.BilinForm ℝ V) (u v : V) : ‖phase σ u v‖ = 1 :=
  Complex.norm_exp_ofReal_mul_I _

/-- The pointwise formula `(W(u)ψ)(v) = e^{iσ(u,v)/2} ψ(v+u)`. -/
def weylFun (σ : LinearMap.BilinForm ℝ V) (u : V) (f : V → ℂ) : V → ℂ :=
  fun v => phase σ u v * f (v + u)

private theorem two_toReal_pos : (0 : ℝ) < (2 : ℝ≥0∞).toReal := by norm_num

/-- An alternating form is antisymmetric (Mathlib's `LinearMap.IsAlt.neg`, sides swapped). -/
theorem isAlt_swap {σ : LinearMap.BilinForm ℝ V} (hσ : σ.IsAlt) (u w : V) :
    σ w u = -σ u w :=
  (hσ.neg u w).symm

theorem memlp_weylFun (σ : LinearMap.BilinForm ℝ V) (u : V) {f : V → ℂ}
    (hf : Memℓp f 2) : Memℓp (weylFun σ u f) 2 := by
  rw [memℓp_gen_iff two_toReal_pos] at hf ⊢
  have : (fun v => ‖weylFun σ u f v‖ ^ (2 : ℝ≥0∞).toReal)
      = (fun v => ‖f v‖ ^ (2 : ℝ≥0∞).toReal) ∘ (Equiv.addRight u) := by
    funext v; simp [weylFun, norm_phase]
  rw [this]
  exact (Equiv.summable_iff (Equiv.addRight u)).2 hf

/-- The Weyl operator as a linear map on `ℓ²(V)`. -/
def weylLin (σ : LinearMap.BilinForm ℝ V) (u : V) : L2 V →ₗ[ℂ] L2 V where
  toFun f := ⟨weylFun σ u f, memlp_weylFun σ u f.2⟩
  map_add' f g := by
    ext v; simp [weylFun, mul_add]; rfl
  map_smul' c f := by
    ext v; simp [weylFun]; ring

theorem norm_weylLin (σ : LinearMap.BilinForm ℝ V) (u : V) (f : L2 V) :
    ‖weylLin σ u f‖ = ‖f‖ := by
  rw [lp.norm_eq_tsum_rpow (E := fun _ : V => ℂ) two_toReal_pos,
    lp.norm_eq_tsum_rpow (E := fun _ : V => ℂ) two_toReal_pos]
  congr 1
  have : (fun v => ‖(weylLin σ u f : V → ℂ) v‖ ^ (2 : ℝ≥0∞).toReal)
      = (fun v => ‖(f : V → ℂ) v‖ ^ (2 : ℝ≥0∞).toReal) ∘ (Equiv.addRight u) := by
    funext v; simp [weylLin, weylFun, norm_phase]
  rw [this]
  exact Equiv.tsum_eq (Equiv.addRight u) (fun v => ‖(f : V → ℂ) v‖ ^ (2 : ℝ≥0∞).toReal)

/-- The Weyl operator `(W(u)ψ)(v) = e^{iσ(u,v)/2} ψ(v+u)`. -/
def weyl (σ : LinearMap.BilinForm ℝ V) (u : V) : L2 V →L[ℂ] L2 V :=
  LinearMap.mkContinuous (weylLin σ u) 1 (fun f => by simp [norm_weylLin])

theorem weyl_apply (σ : LinearMap.BilinForm ℝ V) (u : V) (f : L2 V) (v : V) :
    weyl σ u f v = phase σ u v * f (v + u) := rfl

/-- The Weyl operators preserve the norm. -/
theorem norm_weyl_apply (σ : LinearMap.BilinForm ℝ V) (u : V) (f : L2 V) :
    ‖weyl σ u f‖ = ‖f‖ :=
  norm_weylLin σ u f

theorem weyl_zero (σ : LinearMap.BilinForm ℝ V) : weyl σ 0 = 1 := by
  ext f v
  simp [weyl_apply, phase]

/-- The Weyl relation `W(u) W(w) = e^{-iσ(u,w)/2} W(u+w)`. -/
theorem weyl_mul (σ : LinearMap.BilinForm ℝ V) (hσ : σ.IsAlt) (u w : V) :
    weyl σ u * weyl σ w =
      Complex.exp (((-(σ u w) / 2 : ℝ) : ℂ) * Complex.I) • weyl σ (u + w) := by
  ext f v
  change phase σ u v * (phase σ w (v + u) * f (v + u + w)) =
    Complex.exp (((-(σ u w) / 2 : ℝ) : ℂ) * Complex.I) * (phase σ (u + w) v * f (v + (u + w)))
  simp only [phase]
  have hwu : σ w u = - σ u w := isAlt_swap hσ u w
  rw [← mul_assoc, ← mul_assoc, ← Complex.exp_add, ← Complex.exp_add, add_assoc]
  congr 2
  simp only [map_add, LinearMap.add_apply, hwu]
  push_cast
  ring

theorem weyl_mul_weyl_neg (σ : LinearMap.BilinForm ℝ V) (hσ : σ.IsAlt) (u : V) :
    weyl σ u * weyl σ (-u) = 1 := by
  rw [weyl_mul σ hσ, add_neg_cancel, weyl_zero]
  simp [hσ u]

/-- The adjoint of `W(u)` is `W(-u)`. -/
theorem star_weyl (σ : LinearMap.BilinForm ℝ V) (hσ : σ.IsAlt) (u : V) :
    star (weyl σ u) = weyl σ (-u) := by
  have hiso : star (weyl σ u) * weyl σ u = 1 :=
    (ContinuousLinearMap.norm_map_iff_adjoint_comp_self (weyl σ u)).1 (norm_weyl_apply σ u)
  calc star (weyl σ u) = star (weyl σ u) * (weyl σ u * weyl σ (-u)) := by
        rw [weyl_mul_weyl_neg σ hσ, mul_one]
    _ = weyl σ (-u) := by rw [← mul_assoc, hiso, one_mul]

/-- Each Weyl operator is unitary. -/
theorem weyl_mem_unitary (σ : LinearMap.BilinForm ℝ V) (hσ : σ.IsAlt) (u : V) :
    weyl σ u ∈ unitary (L2 V →L[ℂ] L2 V) := by
  rw [Unitary.mem_iff, star_weyl σ hσ]
  refine ⟨?_, weyl_mul_weyl_neg σ hσ u⟩
  simpa using weyl_mul_weyl_neg σ hσ (-u)

/-- The CCR algebra, the C*-subalgebra of `B(ℓ²(V))` generated by the Weyl operators. -/
def CCR (σ : LinearMap.BilinForm ℝ V) : StarSubalgebra ℂ (L2 V →L[ℂ] L2 V) :=
  (StarAlgebra.adjoin ℂ (Set.range (weyl σ))).topologicalClosure

instance (σ : LinearMap.BilinForm ℝ V) : IsClosed ((CCR σ : Set (L2 V →L[ℂ] L2 V))) :=
  (StarAlgebra.adjoin ℂ (Set.range (weyl σ))).isClosed_topologicalClosure

theorem weyl_mem_CCR (σ : LinearMap.BilinForm ℝ V) (u : V) : weyl σ u ∈ CCR σ :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨u, rfl⟩)

/-- The Weyl operators as unitary elements of `CCR σ`. -/
def CCR.weyl (σ : LinearMap.BilinForm ℝ V) (hσ : σ.IsAlt) (u : V) : unitary (CCR σ) :=
  ⟨⟨Weyl.weyl σ u, weyl_mem_CCR σ u⟩, by
    rw [Unitary.mem_iff]
    constructor <;> apply Subtype.ext <;>
      simp [(Unitary.mem_iff.1 (weyl_mem_unitary σ hσ u)).1,
        (Unitary.mem_iff.1 (weyl_mem_unitary σ hσ u)).2]⟩

@[simp] theorem CCR.coe_weyl (σ : LinearMap.BilinForm ℝ V) (hσ : σ.IsAlt) (u : V) :
    ((CCR.weyl σ hσ u : CCR σ) : L2 V →L[ℂ] L2 V) = Weyl.weyl σ u := rfl

end Weyl

end BosonicLean
